# Copy this file to `.env` and fill in real values before running docker compose.
# Never commit the real `.env` file — it contains your n8n encryption key.

# The domain that points (A record) at your server's public IP, e.g. n8n.example.com
# You need a domain (a free subdomain from Cloudflare, DuckDNS, or afraid.org works fine)
# because Caddy uses it to request a free Let's Encrypt TLS certificate automatically.
N8N_HOST=n8n.example.com

# IANA timezone used for scheduled workflows (e.g. Asia/Karachi, America/New_York)
GENERIC_TIMEZONE=UTC

# Random 32+ character secret used to encrypt saved credentials.
# Generate one with: openssl rand -hex 32
# IMPORTANT: back this up. If you lose it, saved credentials become unrecoverable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-secret
