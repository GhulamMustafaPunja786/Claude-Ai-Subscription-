{{ 'dr-ice-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign book_url = pages['book-appointment'].url | default: '/pages/book-appointment'
  assign about_url = pages.about.url | default: '/pages/about'
  assign quote_url = pages['instant-pendant-quote'].url | default: '/pages/instant-pendant-quote'
  assign chain_quote_url = pages['instant-chain-quote'].url | default: '/pages/instant-chain-quote'
  assign ring_quote_url = pages['instant-ring-quote'].url | default: '/pages/instant-ring-quote'
-%}

<div class="dr-ice-footer">
  <img
    class="dr-ice-footer__brush"
    src="{{ 'dr-ice-footer-brush.png' | asset_url }}"
    alt=""
    width="2000"
    height="181"
  >
  <div class="dr-ice-footer__inner">
    <a class="dr-ice-footer__logo" href="{{ routes.root_url }}" aria-label="Dr. Ice">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 2.2 21.2 12 12 21.8 2.8 12 12 2.2Z" fill="none" stroke="#ffffff" stroke-width="1.2"/>
      </svg>
      <span>DR. ICE</span>
    </a>

    <div class="dr-ice-footer__cols">
      <nav aria-label="Our company">
        <p>Our Company</p>
        <ul>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ about_url }}">About Us</a></li>
          <li><a href="{{ routes.collections_url }}">Shop</a></li>
          <li><a href="{{ book_url }}">Book Appointment</a></li>
        </ul>
      </nav>
      <nav class="dr-ice-footer__collection" aria-label="Collection">
        <p>Collection</p>
        <div>
          <ul>
            <li><a href="/collections/pendants">Pendants</a></li>
            <li><a href="/collections/wedding-rings">Wedding rings</a></li>
            <li><a href="/collections/cuban-chains">Cuban chains</a></li>
            <li><a href="/collections/grillz">Grillz</a></li>
          </ul>
          <ul>
            <li><a href="/collections/bracelets">Bracelets</a></li>
            <li><a href="/collections/earrings">Ear rings</a></li>
            <li><a href="/collections/mens-rings">Mens rings</a></li>
            <li><a href="/collections/merch">Merch</a></li>
          </ul>
        </div>
      </nav>
      <nav aria-label="Quote">
        <p>Quote</p>
        <ul>
          <li><a href="{{ quote_url }}">Instant Pendant Quote</a></li>
          <li><a href="{{ chain_quote_url }}">Instant Chain Quote</a></li>
          <li><a href="{{ ring_quote_url }}">Instant Ring Quote</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="dr-ice-footer__base" id="dr-ice-footer-end">
    <div class="dr-ice-footer__legal">
    <p>©2026 Dr Ice Jewelry. All rights reserved</p>
    <ul class="dr-ice-footer__social" aria-label="Social">
      <li>
        <a href="https://www.facebook.com/" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.1C12.4 3 11 4.4 11 6.6v1.9H9v2.8h2V21h3.5v-9.7h2.3l.4-2.8h-2.7Z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M6.7 9.3H4V20h2.7V9.3ZM5.3 4A1.6 1.6 0 1 0 5.3 7.2 1.6 1.6 0 0 0 5.3 4ZM20 20h-2.7v-5.2c0-1.5-.6-2.5-1.9-2.5-1 0-1.6.7-1.9 1.4-.1.2-.1.6-.1.9V20H10.7s.1-9.3 0-10.7h2.7v1.8c.4-.6 1.2-1.6 3-1.6 2.2 0 3.6 1.4 3.6 4.5V20Z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.youtube.com/" aria-label="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M21 8.2a3 3 0 0 0-2.1-2.1C17.2 5.7 12 5.7 12 5.7s-5.2 0-6.9.4A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.7.4 6.9.4 6.9.4s5.2 0 6.9-.4a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8ZM10.4 14.8V9.2L15.2 12l-4.8 2.8Z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.instagram.com/" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm8 1.8H8A3.2 3.2 0 0 0 4.8 8v8A3.2 3.2 0 0 0 8 19.2h8A3.2 3.2 0 0 0 19.2 16V8A3.2 3.2 0 0 0 16 4.8ZM12 8.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2Zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8Zm4.4-2.9a.9.9 0 1 1-.9.9.9.9 0 0 1 .9-.9Z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.tiktok.com/" aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M14.2 3h2.1a5.4 5.4 0 0 0 3.5 3.3v2.2a7.4 7.4 0 0 1-3.5-1v6.7a5.8 5.8 0 1 1-5.8-5.8c.3 0 .6 0 .9.1v2.4a3.4 3.4 0 1 0 2.3 3.2V3Z"/></svg>
        </a>
      </li>
    </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dr. Ice footer",
  "tag": "div",
  "class": "dr-ice-footer-section",
  "settings": [],
  "presets": [
    {
      "name": "Dr. Ice footer"
    }
  ]
}
{% endschema %}
