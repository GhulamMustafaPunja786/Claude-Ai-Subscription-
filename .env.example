# Copy to .env and fill in, or just run ./scripts/gen-env.sh which does it for you
# and generates the secrets. Never commit .env.

# ---------------------------------------------------------------------------
# Secrets (required). Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Encrypts every credential you store in n8n. BACK THIS UP. If you lose it,
# your saved credentials become permanently unreadable, even with a DB backup.
N8N_ENCRYPTION_KEY=
# Signs login sessions. Changing it just logs everyone out.
N8N_USER_MANAGEMENT_JWT_SECRET=
# Postgres password (ignored by docker-compose.sqlite.yml).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# Local testing: leave these as-is and open http://localhost:5678
# Public server: set N8N_HOST to your domain, N8N_PROTOCOL=https,
# WEBHOOK_URL=https://your.domain/ (trailing slash!) and N8N_PROXY_HOPS=1.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Number of reverse proxies in front of n8n. 0 = direct, 1 = behind Caddy or
# Cloudflare Tunnel, 2 = behind Cloudflare's proxy *and* your own.
N8N_PROXY_HOPS=0

# Browsers only send secure cookies over HTTPS. Keep false for plain-http
# access (localhost or a bare IP), set true once you are on https://.
N8N_SECURE_COOKIE=false

# Where the container port is published. 127.0.0.1 means only a reverse proxy
# or tunnel on the same host can reach it - the safe default for a public VM.
# Use 0.0.0.0 only if you accept an unencrypted editor on the open internet.
N8N_BIND_ADDRESS=127.0.0.1
N8N_PUBLISHED_PORT=5678

# ---------------------------------------------------------------------------
# HTTPS options (pick one, both are free)
# ---------------------------------------------------------------------------
# caddy profile: Let's Encrypt certificate for N8N_HOST. Needs ports 80+443
# open and a DNS A record pointing at the VM.
LETSENCRYPT_EMAIL=

# tunnel profile: Cloudflare Tunnel. No open inbound ports at all, works
# behind NAT/CGNAT. Get the token from Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Pinned so an unattended `docker compose pull` cannot break a running box.
# Check the tag before bumping: https://github.com/n8n-io/n8n/releases
N8N_IMAGE_TAG=2.35.5

# Affects Schedule/Cron trigger times. e.g. Asia/Karachi, Europe/London, UTC
GENERIC_TIMEZONE=UTC

POSTGRES_USER=n8n
POSTGRES_DB=n8n

# Execution history retention. Hours of history, and a hard row cap.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
# all | none - "none" saves a lot of disk on high-volume workflows, at the
# cost of not being able to inspect successful runs afterwards.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# Blocks $env access inside Code nodes so a workflow cannot read your secrets.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Node.js heap cap in MB, only used by docker-compose.sqlite.yml.
NODE_MAX_OLD_SPACE_MB=512
