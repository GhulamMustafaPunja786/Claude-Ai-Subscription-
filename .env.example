# Copy to .env and fill in values. Never commit .env.

# Required. Generate once and keep forever (credentials become unreadable if this changes):
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Karachi
N8N_VERSION=2.36.3

# --- Local docker compose (docker-compose.yml) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# --- Oracle / VPS with Caddy (docker-compose.postgres.yml) ---
# N8N_HOST=n8n.yourdomain.com
# N8N_PROTOCOL=https
# N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com
# WEBHOOK_URL=https://n8n.yourdomain.com/
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=
# POSTGRES_DB=n8n

# --- Hugging Face Spaces + Supabase (set these in the Space UI, not in git) ---
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=db.<project-ref>.supabase.co
# DB_POSTGRESDB_PORT=6543
# DB_POSTGRESDB_DATABASE=postgres
# DB_POSTGRESDB_USER=postgres
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SSL_ENABLED=true
# N8N_HOST=<you>-<space>.hf.space
# N8N_EDITOR_BASE_URL=https://<you>-<space>.hf.space
# WEBHOOK_URL=https://<you>-<space>.hf.space/
# N8N_PROTOCOL=https
# N8N_PORT=7860
# N8N_PROXY_HOPS=1

# --- Typeform -> WhatsApp workflow ---
# Meta Cloud API: developers.facebook.com > your app > WhatsApp > API setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your personal/business number that should receive new-lead alerts (digits only, country code, no +)
WHATSAPP_NOTIFY_TO=
